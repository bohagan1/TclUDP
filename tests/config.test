# Port


test Port-12.1 {Use Default} -body {
	set ch [udp_open]
	expr {[chan configure $ch -myport] > 0}
    } -cleanup {
	close $ch
    } -result {1}

test Port-12.2 {Set Default Port} -body {
	set ch [udp_open 0]
	expr {[chan configure $ch -myport] > 0}
    } -cleanup {
	close $ch
    } -result {1}

test Port-12.3 {Set Port} -body {
	set ch [udp_open 5000]
	chan configure $ch -myport
    } -cleanup {
	close $ch
    } -result {5000}

test Port-12.4 {Set IPv4 Port Number} -body {
	set ch [udp_open 5001 ipv4]
	chan configure $ch -myport
    } -cleanup {
	close $ch
    } -result {5001}

test Port-12.5 {Set IPv6 Port Number} -body {
	set ch [udp_open 5002 ipv6]
	chan configure $ch -myport
    } -cleanup {
	close $ch
    } -result {5002}

test Port-12.6 {Set IPv4 Service Name} -constraints {win} -body {
	set ch [udp_open https ipv4]
	chan configure $ch -myport
    } -cleanup {
	close $ch
    } -result {443}

test Port-12.7 {Set IPv6 Service Name} -constraints {win} -body {
	set ch [udp_open https ipv6]
	chan configure $ch -myport
    } -cleanup {
	close $ch
    } -result {443}

test Port-12.8 {Set IPv4 Service Name} -constraints {unix} -body {
	set ch [udp_open https ipv4]
	chan configure $ch -myport
    } -result {failed to bind socket to port: Permission denied} -returnCodes {1}

test Port-12.9 {Set IPv6 Service Name} -constraints {unix} -body {
	set ch [udp_open https ipv6]
	chan configure $ch -myport
    } -result {failed to bind socket to port: Permission denied} -returnCodes {1}

test Port-12.10 {Invalid Port IPv4} -body {
	udp_open -200 ipv4
    } -result {couldn't open socket: port number too low} -returnCodes {1}

test Port-12.11 {Invalid Port IPv6} -body {
	udp_open -300 ipv6
    } -result {couldn't open socket: port number too low} -returnCodes {1}

test Port-12.12 {Out of Range Port IPv4} -body {
	udp_open 80000 ipv4
    } -result {couldn't open socket: port number too high} -returnCodes {1}

test Port-12.13 {Out of Range Port IPv6} -body {
	udp_open 70000 ipv6
    } -result {couldn't open socket: port number too high} -returnCodes {1}

test Port-12.14 {Invalid Service Name IPv4} -body {
	udp_open bogus ipv4
    } -result {unknown service name "bogus" for protocol "udp"} -returnCodes {1}

test Port-12.15 {Invalid Service Name IPv6} -body {
	udp_open bogus ipv6
    } -result {unknown service name "bogus" for protocol "udp"} -returnCodes {1}

# Remote


test Remote-13.1 {Get Remote IPv4} -setup {
	set ch [udp_open ipv4]
    } -body {
	chan configure $ch -remote
    } -cleanup {
	close $ch
    }

test Remote-13.2 {Get Remote IPv6} -setup {
	set ch [udp_open ipv6]
    } -body {
	chan configure $ch -remote
    } -cleanup {
	close $ch
    }

test Remote-13.3 {Set Remote IPv4} -setup {
	set ch [udp_open ipv4]
    } -body {
	chan configure $ch -remote [list  google.com 80]
    } -cleanup {
	close $ch
    } -result {google.com 80}

test Remote-13.4 {Set Remote IPv6} -setup {
	set ch [udp_open ipv6]
    } -body {
	chan configure $ch -remote [list google.com 80]
    } -cleanup {
	close $ch
    } -result {google.com 80}

test Remote-13.5 {Set Remote Default Port IPv4} -setup {
	set ch [udp_open ipv4]
    } -body {
	chan configure $ch -remote [list  google.com]
    } -cleanup {
	close $ch
    } -result {google.com}

test Remote-13.6 {Set Remote Default Port IPv6} -setup {
	set ch [udp_open ipv6]
    } -body {
	chan configure $ch -remote [list google.com]
    } -cleanup {
	close $ch
    } -result {google.com}

test Remote-13.7 {No values} -setup {
	set ch [udp_open]
    } -body {
	chan configure $ch -remote [list]
    } -cleanup {
	close $ch
    } -result {wrong # args: should be "?hostname? ?port?"} -returnCodes {1}

test Remote-13.8 {Too many values} -setup {
	set ch [udp_open]
    } -body {
	chan configure $ch -remote [list bogus value value]
    } -cleanup {
	close $ch
    } -result {wrong # args: should be "?hostname? ?port?"} -returnCodes {1}

test Remote-13.9 {Invalid value} -setup {
	set ch [udp_open]
    } -body {
	chan configure $ch -remote [list 1.1.1.1 value]
    } -cleanup {
	close $ch
    } -result {unknown service name "value" for protocol "udp"} -returnCodes {1}

test Remote-13.10 {Invalid IPv4 address} -constraints {knownBug} -setup {
	set ch [udp_open ipv4]
    } -body {
	chan configure $ch -remote [list 500.0.0.0 80]
    } -cleanup {
	close $ch
    } -result {couldn't open socket: invalid address} -returnCodes {1}

test Remote-13.11 {Invalid IPv6 address} -constraints {knownBug} -setup {
	set ch [udp_open ipv6]
    } -body {
	chan configure $ch -remote [list 500.0.0.0 80]
    } -cleanup {
	close $ch
    } -result {couldn't open socket: invalid address} -returnCodes {1}

test Remote-13.12 {Negative port} -setup {
	set ch [udp_open]
    } -body {
	chan configure $ch -remote [list 192.168.1.1 -80]
    } -cleanup {
	close $ch
    } -result {port number out of range} -returnCodes {1}

test Remote-13.13 {Out of range port} -setup {
	set ch [udp_open]
    } -body {
	chan configure $ch -remote [list 192.168.1.1 100000]
    } -cleanup {
	close $ch
    } -result {port number out of range} -returnCodes {1}

