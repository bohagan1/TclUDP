	set ch [udp_open]
    } -body {
	chan configure $ch -ttl -1
	chan configure $ch -ttl
    } -cleanup {
	close $ch
    } -match {glob} -result {*}

test TTL-14.8 {Set IPv4} -setup {
	set ch [udp_open ipv4]
    } -body {
	chan configure $ch -ttl 72
	chan configure $ch -ttl
    } -cleanup {
	close $ch
    } -result {72}

test TTL-14.9 {Set IPv6} -setup {
	set ch [udp_open ipv6]
    } -body {
	chan configure $ch -ttl 84
	chan configure $ch -ttl
    } -cleanup {
	close $ch
    } -result {84}

test TTL-14.10 {Invalid value} -setup {
	set ch [udp_open]
    } -body {
	chan configure $ch -ttl bogus
    } -cleanup {
	close $ch
    } -result {expected integer but got "bogus"} -returnCodes {1}

test TTL-14.11 {Out of range value IPv4} -constraints {!mac} -setup {
	set ch [udp_open]
    } -body {
	chan configure $ch -ttl 257
    } -cleanup {
	close $ch
    } -match {glob} -result {error setting -ttl: *[Ii]nvalid argument*} -returnCodes {1}

test TTL-14.12 {Out of range value IPv6} -setup {
	set ch [udp_open ipv6]
    } -body {
	chan configure $ch -ttl 257
    } -cleanup {
	close $ch
    } -match {glob} -result {error setting -ttl: *[Ii]nvalid argument*} -returnCodes {1}
