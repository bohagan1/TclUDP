# Auto generated test cases for config.csv

# Load Tcl Test package
if {[lsearch [namespace children] ::tcltest] == -1} {
	package require tcltest
	namespace import ::tcltest::*
}

set auto_path [concat [list [file dirname [file dirname [info script]]]] $auto_path]

package require udp

# Constraints
::tcltest::testConstraint win7 [expr {$::tcl_platform(platform) eq "windows" && $::tcl_platform(osVersion) == 6.1}]
::tcltest::testConstraint win10 [expr {$::tcl_platform(platform) eq "windows" && $::tcl_platform(osVersion) > 6.1}]
::tcltest::testConstraint tcl8 [expr {[info tclversion] < 9.0}]
::tcltest::testConstraint tcl9 [expr {[info tclversion] >= 9.0}]
::tcltest::testConstraint mac [expr {$tcl_platform(os) eq "Darwin"}]
::tcltest::testConstraint !mac [expr {$tcl_platform(os) ne "Darwin"}]

set mc_port 55000

# UDP Open Test Cases


test Open-1.1 {Too many args} -body {
	udp_open 1 2 3 4 5
    } -result {wrong # args: should be "udp_open ?localport? ?ipv6? ?reuse?"} -returnCodes {1}

test Open-1.2 {Invalid port} -body {
	udp_open 66666
    } -result {couldn't open socket: port number too high} -returnCodes {1}

test Open-1.3 {Invalid port range} -body {
	udp_open -2
    } -result {couldn't open socket: port number too low} -returnCodes {1}

test Open-1.4 {Invalid service} -body {
	udp_open bogus
    } -result {unknown service name "bogus" for protocol "udp"} -returnCodes {1}

test Open-1.5 {Invalid option} -body {
	udp_open 54321 bogus
    } -result {unknown service name "bogus" for protocol "udp"} -returnCodes {1}

test Open-1.6 {Close Chan} -setup {
	set ch [udp_open]
    } -body {
	close $ch
	expr {$ch in [chan names]}
    } -result {0}

test Open-1.7 {Check Existence} -setup {
	set ch [udp_open]
    } -body {
	expr {$ch in [chan names]}
    } -cleanup {
	close $ch
    } -result {1}

test Open-1.8 {Service Win} -constraints {win} -body {
	set ch [udp_open https]
    } -cleanup {
	close $ch
    } -match {glob} -result {*}

test Open-1.9 {Service UNIX} -constraints {unix} -body {
	set ch [udp_open https]
    } -cleanup {
	catch {close $ch}
    } -match {glob} -result {failed to bind socket to port: Permission denied} -returnCodes {1}

test Open-1.10 {Reuse} -body {
	set ch [udp_open 54321 reuse]
    } -cleanup {
	close $ch
    } -match {glob} -result {*}

test Open-1.11 {IPv4} -body {
	set ch [udp_open 54321 ipv4]
    } -cleanup {
	close $ch
    } -match {glob} -result {*}

test Open-1.12 {IPv6} -body {
	set ch [udp_open 54321 ipv6]
    } -cleanup {
	close $ch
    } -match {glob} -result {*}

test Open-1.13 {All} -body {
	set ch [udp_open 54321 ipv6 reuse]
    } -cleanup {
	close $ch
    } -match {glob} -result {*}

test Open-1.14 {Duplicate Port No Reuse} -constraints {win} -setup {
	set ch [udp_open]
    } -body {
	udp_open [chan configure $ch -myport]
    } -cleanup {
	close $ch
    } -match {glob} -result {failed to bind socket to port: Only one usage of each socket address (protocol/network address/port) is normally permitted.*} -returnCodes {1}

test Open-1.15 {Duplicate Port No Reuse} -constraints {unix} -setup {
	set ch [udp_open]
    } -body {
	udp_open [chan configure $ch -myport]
    } -cleanup {
	close $ch
    } -match {glob} -result {failed to bind socket to port: Address already in use} -returnCodes {1}

test Open-1.16 {Duplicate Port With Reuse} -constraints {win} -setup {
	set ch [udp_open reuse]
    } -body {
	udp_open [chan configure $ch -myport]
    } -cleanup {
	close $ch
    } -match {glob} -result {failed to bind socket to port: Only one usage of each socket address (protocol/network address/port) is normally permitted.*} -returnCodes {1}

test Open-1.17 {Duplicate Port With Reuse} -constraints {unix} -setup {
	set ch [udp_open reuse]
    } -body {
	udp_open [chan configure $ch -myport]
    } -cleanup {
	close $ch
    } -match {glob} -result {failed to bind socket to port: Address already in use} -returnCodes {1}

# Chan configure


test Chan_Config-2.1 {Too few args} -setup {
	set ch [udp_open]
    } -body {
	chan configure
    } -cleanup {
	close $ch
    } -match {glob} -result {wrong # args: should be "chan configure channel* ?-option value ...?"} -returnCodes {1}

test Chan_Config-2.2 {Too many args} -setup {
	set ch [udp_open]
    } -body {
	chan configure $ch -broadcast 1 2
    } -cleanup {
	close $ch
    } -match {glob} -result {wrong # args: should be "chan configure channel* ?-option value ...?"} -returnCodes {1}

test Chan_Config-2.3 {Get Invalid option} -setup {
	set ch [udp_open]
    } -body {
	chan configure $ch -bogus
    } -cleanup {
	close $ch
    } -result {bad option "-bogus": must be -broadcast, -family, -mcastadd, -mcastdrop, -mcastgroups, -mcastif, -mcastloop, -myport, -peer, -remote, or -ttl} -returnCodes {1}

test Chan_Config-2.4 {Set Invalid option} -setup {
	set ch [udp_open]
    } -body {
	chan configure $ch -bogus value
    } -cleanup {
	close $ch
    } -result {bad option "-bogus": must be -broadcast, -family, -mcastadd, -mcastdrop, -mcastgroups, -mcastif, -mcastloop, -myport, -peer, -remote, or -ttl} -returnCodes {1}

test Chan_Config-2.5 {Chan Config Get All} -constraints {tcl9 unix} -setup {
	set ch [udp_open]
    } -body {
	chan configure $ch
    } -cleanup {
	close $ch
    } -match {glob} -result "-blocking 1 -buffering full -buffersize 65535 -encoding * -eofchar * -profile strict -translation * -broadcast 0 -family ipv4 -mcastgroups {} -mcastif * -mcastloop 1 -myport * -peer {} -remote {} -ttl *"

test Chan_Config-2.6 {Chan Config Get All} -constraints {tcl9 win} -setup {
	set ch [udp_open]
    } -body {
	chan configure $ch
    } -cleanup {
	close $ch
    } -match {glob} -result "-blocking 1 -buffering full -buffersize 65535 -encoding * -eofchar * -profile strict -translation * -broadcast 0 -family ipv4 -mcastgroups {} -mcastloop 1 -myport * -peer {} -remote {} -ttl *"

test Chan_Config-2.7 {Fconfigure Get All} -constraints {tcl8 unix} -setup {
	set ch [udp_open]
    } -body {
	fconfigure $ch
    } -cleanup {
	close $ch
    } -match {glob} -result "-blocking 1 -buffering full -buffersize 65535 -encoding * -eofchar * -translation * -broadcast 0 -family ipv4 -mcastgroups {} -mcastif * -mcastloop 1 -myport * -peer {} -remote {} -ttl *"

test Chan_Config-2.8 {Fconfigure Get All} -constraints {tcl8 win} -setup {
	set ch [udp_open]
    } -body {
	fconfigure $ch
    } -cleanup {
	close $ch
    } -match {glob} -result "-blocking 1 -buffering full -buffersize 65535 -encoding * -eofchar * -translation * -broadcast 0 -family ipv4 -mcastgroups {} -mcastloop 1 -myport * -peer {} -remote {} -ttl *"

# Broadcast


test Broadcast-3.1 {Get broadcast IPv4} -setup {
	set ch [udp_open [incr ::mc_port]]
    } -body {
	chan configure $ch -broadcast
    } -cleanup {
	close $ch
    } -result {0}

test Broadcast-3.2 {Get broadcast IPv6} -setup {
	set ch [udp_open [incr ::mc_port] ipv6]
    } -body {
	chan configure $ch -broadcast
    } -cleanup {
	close $ch
    } -result {0}

test Broadcast-3.3 {Set broadcast IPv4} -setup {
	set ch [udp_open [incr ::mc_port]]
    } -body {
	chan configure $ch -broadcast 1
	chan configure $ch -broadcast
    } -cleanup {
	close $ch
    } -result {1}

test Broadcast-3.4 {Set broadcast IPv6} -setup {
	set ch [udp_open [incr ::mc_port] ipv6]
    } -body {
	chan configure $ch -broadcast 1
	chan configure $ch -broadcast
    } -cleanup {
	close $ch
    } -result {1}

test Broadcast-3.5 {Invalid value} -setup {
	set ch [udp_open [incr ::mc_port]]
    } -body {
	chan configure $ch -broadcast bogus
    } -cleanup {
	close $ch
    } -result {expected boolean value but got "bogus"} -returnCodes {1}

# Family


test Family-4.1 {Get Family} -setup {
	set ch [udp_open]
    } -body {
	chan configure $ch -family
    } -cleanup {
	close $ch
    } -result {ipv4}

test Family-4.2 {Get Family IPv4} -setup {
	set ch [udp_open ipv4]
    } -body {
	chan configure $ch -family
    } -cleanup {
	close $ch
    } -result {ipv4}

test Family-4.3 {Get Family IPv6} -setup {
	set ch [udp_open ipv6]
    } -body {
	chan configure $ch -family
    } -cleanup {
	close $ch
    } -result {ipv6}

test Family-4.4 {Set Family IPv4} -setup {
	set ch [udp_open ipv4]
    } -body {
	chan configure $ch -family ipv6
    } -cleanup {
	close $ch
    } -result {get only option "-family"} -returnCodes {1}

test Family-4.5 {Set Family IPv6} -setup {
	set ch [udp_open]
    } -body {
	chan configure $ch -family ipv4
    } -cleanup {
	close $ch
    } -result {get only option "-family"} -returnCodes {1}

# Multicast Add


test Multicast_Add-5.1 {Join None} -setup {
	set ch [udp_open [incr ::mc_port]]
    } -body {
	chan configure $ch -mcastadd
    } -cleanup {
	close $ch
    } -result {set only option "-mcastadd"} -returnCodes {1}

test Multicast_Add-5.2 {Join Empty} -setup {
	set ch [udp_open [incr ::mc_port]]
    } -body {
	chan configure $ch -mcastadd {}
    } -cleanup {
	close $ch
    } -result {multicast group and/or local network interface not specified} -returnCodes {1}

test Multicast_Add-5.3 {Join Invalid} -setup {
	set ch [udp_open [incr ::mc_port]]
    } -body {
	chan configure $ch -mcastadd bogus
    } -cleanup {
	close $ch
    } -result {invalid group name} -returnCodes {1}

test Multicast_Add-5.4 {Join IPv4} -setup {
	set ch [udp_open [incr ::mc_port] ipv4]
    } -body {
	chan configure $ch -mcastadd 224.0.0.0
	chan configure $ch -mcastgroup
    } -cleanup {
	close $ch
    } -result {224.0.0.0}

test Multicast_Add-5.5 {Join IPv6} -constraints {!mac} -setup {
	set ch [udp_open [incr ::mc_port] ipv6]
    } -body {
	chan configure $ch -mcastadd ff02::1
	chan configure $ch -mcastgroup
    } -cleanup {
	close $ch
    } -result {ff02::1}

test Multicast_Add-5.6 {Join IPv6} -constraints {mac} -setup {
	set ch [udp_open [incr ::mc_port] ipv6]
    } -body {
	chan configure $ch -mcastadd {ff02::1 en0}
	chan configure $ch -mcastgroup
    } -cleanup {
	close $ch
    } -result {{ff02::1 en0}}

test Multicast_Add-5.7 {IPv6 address for IPv4 port} -setup {
	set ch [udp_open [incr ::mc_port] ipv4]
    } -body {
	chan configure $ch -mcastadd ff02::1
    } -cleanup {
	close $ch
    } -result {invalid group name} -returnCodes {1}

test Multicast_Add-5.8 {IPv4 address for IPv6 port} -constraints {!mac} -setup {
	set ch [udp_open [incr ::mc_port] ipv6]
    } -body {
	chan configure $ch -mcastadd 224.0.0.0
    } -cleanup {
	close $ch
    } -result {invalid group name} -returnCodes {1}

