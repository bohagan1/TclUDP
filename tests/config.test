# ::udp::getaddrinfo


test GetAddrInfo-17.1 {Too few args} -body {
	::udp::getaddrinfo
    } -result {wrong # args: should be "::udp::getaddrinfo ?-hostname name? ?-port|-service id? ?-ipv4|-ipv6? ?-server? ?-tcp|-udp?"} -returnCodes {1}

test GetAddrInfo-17.2 {Too many args} -body {
	::udp::getaddrinfo
    } -result {wrong # args: should be "::udp::getaddrinfo ?-hostname name? ?-port|-service id? ?-ipv4|-ipv6? ?-server? ?-tcp|-udp?"} -returnCodes {1}

test GetAddrInfo-17.3 {Invalid arg} -body {
	::udp::getaddrinfo -bogus value
    } -result {bad option "-bogus": must be -hostname, -ipv4, -ipv6, -port, -server, -service, -tcp, or -udp} -returnCodes {1}

test GetAddrInfo-17.4 {Hostname} -body {
	::udp::getaddrinfo -hostname google.com
    } -match {glob} -result {*}

test GetAddrInfo-17.5 {Hostname No Value} -body {
	::udp::getaddrinfo -hostname
    } -result {No hostname} -returnCodes {1}

test GetAddrInfo-17.6 {IPv4} -body {
	lindex [lindex [::udp::getaddrinfo -hostname google.com -ipv4] 0] 1
    } -result {ipv4}

test GetAddrInfo-17.7 {IPv6} -body {
	lindex [lindex [::udp::getaddrinfo -hostname google.com -ipv6] 0] 1
    } -result {ipv6}

test GetAddrInfo-17.8 {Port} -body {
	lindex [lindex [::udp::getaddrinfo -hostname google.com -port 80] 0] 5
    } -result {80}

test GetAddrInfo-17.9 {Service} -body {
	lindex [lindex [::udp::getaddrinfo -hostname google.com -service https] 0] 5
    } -result {443}

test GetAddrInfo-17.10 {Port no value} -body {
	::udp::getaddrinfo -hostname google.com -port
    } -result {No port/service} -returnCodes {1}

test GetAddrInfo-17.11 {Service no value} -body {
	::udp::getaddrinfo -hostname google.com -service
    } -result {No port/service} -returnCodes {1}

test GetAddrInfo-17.12 {Server} -body {
	::udp::getaddrinfo -hostname google.com -server
    } -match {glob} -result {*}

test GetAddrInfo-17.13 {TCP} -body {
	lindex [lindex [::udp::getaddrinfo -hostname google.com -tcp] 0] 7
    } -result {tcp}

test GetAddrInfo-17.14 {UDP} -body {
	lindex [lindex [::udp::getaddrinfo -hostname google.com -udp] 0] 7
    } -result {udp}

# ::udp::getnameinfo


test GetNameInfo-18.1 {Too few args} -body {
	::udp::getnameinfo
    } -result {wrong # args: should be "::udp::getnameinfo address ?ipv6?"} -returnCodes {1}

test GetNameInfo-18.2 {Too many args} -body {
	::udp::getnameinfo arg1 arg2 arg3
    } -result {wrong # args: should be "::udp::getnameinfo address ?ipv6?"} -returnCodes {1}

test GetNameInfo-18.3 {Invalid IPv4 address} -body {
	::udp::getnameinfo 500.0.0.1
    } -result {Invalid IPv4 address 500.0.0.1} -returnCodes {1}

test GetNameInfo-18.4 {Invalid IPv6 address} -body {
	::udp::getnameinfo 1234:ghij::0
    } -result {Invalid IPv6 address 1234:ghij::0} -returnCodes {1}

test GetNameInfo-18.5 {Bad address} -body {
	::udp::getnameinfo 500.0.0.0
    } -result {Invalid IPv4 address 500.0.0.0} -returnCodes {1}

test GetNameInfo-18.6 {Localhost IPv4} -constraints {win} -body {
	string tolower [ ::udp::getnameinfo 127.0.0.1]
    } -result [info hostname]

test GetNameInfo-18.7 {Localhost IPv6} -constraints {win} -body {
	string tolower [ ::udp::getnameinfo ::1 ipv6]
    } -result [info hostname]

test GetNameInfo-18.8 {Localhost IPv6 Autodetect} -constraints {win} -body {
	string tolower [ ::udp::getnameinfo ::1]
    } -result [info hostname]

test GetNameInfo-18.9 {Localhost IPv4} -constraints {unix} -body {
	string tolower [ ::udp::getnameinfo 127.0.0.1]
    } -result {localhost}

test GetNameInfo-18.10 {Localhost IPv6} -constraints {unix} -body {
	string tolower [ ::udp::getnameinfo ::1 ipv6]
    } -result {localhost}

test GetNameInfo-18.11 {Localhost IPv6 Autodetect} -constraints {unix} -body {
	string tolower [ ::udp::getnameinfo ::1]
    } -result {localhost}

